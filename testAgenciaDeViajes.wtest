describe "Calcular Valor Final" {
    method initialize(){
    const packItalia = new Pack(escalas = 1, paisDestino = "italia", duracionDias = 3, cordinadorACargo = "cris", precioBase = 200)
    }
    test "Pack nacional sin beneficios vigentes devuelve mismo precio base"{
    assert.equals(packItalia.precioBase(), 200)
    }
}