describe "Calcular Valor Final" {
    method initialize(){
    const packItalia = new PackNacional(duracionDias = 3,cordinadorACargo = "cris", precioBase = 200, escalas = 1, paisDestino = 3)
    }
    test "Pack nacional sin beneficios vigentes devuelve mismo precio base"{
    assert.equals(packItalia.escalas(), 1)
    }
}